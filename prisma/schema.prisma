generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  telegramId  String   @unique
  username    String?
  firstName   String?
  lastName    String?
  age         Int?
  gender      String?
  lookingFor  String?
  bio         String?
  photoUrl    String?
  interests   String[]
  photos      String[]

  isBoosted      Boolean   @default(false)
  boostExpiry    DateTime?
  superLikesLeft Int       @default(3)
  boostsLeft     Int       @default(1)
  rosesLeft      Int       @default(5)

  isPremium    Boolean   @default(false)
  premiumTier  String?
  premiumUntil DateTime?

  isVerified         Boolean @default(false)
  verificationStatus String  @default("none")

  incognito      Boolean @default(false)
  notifyMatches  Boolean @default(true)
  notifyLikes    Boolean @default(true)
  notifyMessages Boolean @default(true)

  latitude     Float?
  longitude    Float?
  city         String?
  passportCity String?

  prefAgeMin  Int @default(18)
  prefAgeMax  Int @default(60)
  maxDistance Int @default(100)

  isOnline    Boolean  @default(false)
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  theme        String? @default("dark")
  language     String? @default("fa")
  fontSize     String? @default("medium")
  highContrast Boolean @default(false)
  reduceMotion Boolean @default(false)
  calmMode     Boolean @default(false)
  stars        Int     @default(0)

  likesGiven    Like[] @relation("LikesGiven")
  likesReceived Like[] @relation("LikesReceived")
  matches1      Match[] @relation("MatchUser1")
  matches2      Match[] @relation("MatchUser2")
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  prompts        ProfilePrompt[]
  stories        Story[]
  storyViews     StoryView[]     @relation("StoryViewer")
  giftsSent      Gift[]          @relation("GiftFrom")
  giftsReceived  Gift[]          @relation("GiftTo")
  hostedEvents   Event[]         @relation("EventHost")
  eventAttendees EventAttendee[]
  purchases      Purchase[]
  reportsMade    Report[]        @relation("ReportFrom")
  reportsReceived Report[]       @relation("ReportTo")
  notifications  Notification[]
  ledgerEntries  LedgerEntry[]

  @@index([gender])
  @@index([lastSeen])
  @@index([isBoosted, createdAt])
  @@index([incognito, age, gender])
}

model Like {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  action     String
  createdAt  DateTime @default(now())
  fromUser User @relation("LikesGiven", fields: [fromUserId], references: [id])
  toUser   User @relation("LikesReceived", fields: [toUserId], references: [id])
  @@unique([fromUserId, toUserId])
  @@index([toUserId, action])
  @@index([fromUserId])
}

model Match {
  id        Int      @id @default(autoincrement())
  user1Id   Int
  user2Id   Int
  createdAt DateTime @default(now())
  user1    User      @relation("MatchUser1", fields: [user1Id], references: [id])
  user2    User      @relation("MatchUser2", fields: [user2Id], references: [id])
  messages Message[]
  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id        Int      @id @default(autoincrement())
  matchId   Int
  senderId  Int
  receiverId Int
  text      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  match    Match @relation(fields: [matchId], references: [id])
  sender   User  @relation("SentMessages", fields: [senderId], references: [id])
  receiver User  @relation("ReceivedMessages", fields: [receiverId], references: [id])
  @@index([matchId])
  @@index([matchId, createdAt])
  @@index([senderId])
  @@index([receiverId, read])
}

model ProfilePrompt {
  id       Int    @id @default(autoincrement())
  userId   Int
  question String
  answer   String
  order    Int    @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Story {
  id        Int      @id @default(autoincrement())
  userId    Int
  imageUrl  String
  caption   String?
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyViews StoryView[]
  @@index([userId])
  @@index([expiresAt])
  @@index([expiresAt, createdAt])
}

model StoryView {
  id        Int      @id @default(autoincrement())
  storyId   Int
  viewerId  Int
  createdAt DateTime @default(now())
  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation("StoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  @@unique([storyId, viewerId])
  @@index([viewerId])
}

model Gift {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  type       String
  message    String?
  createdAt  DateTime @default(now())
  fromUser User @relation("GiftFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("GiftTo", fields: [toUserId], references: [id], onDelete: Cascade)
  @@index([fromUserId])
  @@index([toUserId])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  coverUrl    String?
  category    String?
  city        String?
  location    String?
  startsAt    DateTime
  hostId      Int?
  createdAt   DateTime @default(now())
  host      User?           @relation("EventHost", fields: [hostId], references: [id], onDelete: SetNull)
  attendees EventAttendee[]
  @@index([startsAt])
  @@index([hostId])
}

model EventAttendee {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userId    Int
  createdAt DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
  @@index([userId])
}

model Purchase {
  id        Int      @id @default(autoincrement())
  userId    Int
  item      String
  quantity  Int      @default(1)
  amount    Float    @default(0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Report {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  reason     String
  status     String   @default("open")
  createdAt  DateTime @default(now())
  fromUser User @relation("ReportFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser User @relation("ReportTo", fields: [toUserId], references: [id], onDelete: Cascade)
  @@index([fromUserId])
  @@index([toUserId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String?
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([userId, read])
}

model LedgerEntry {
  id            Int      @id @default(autoincrement())
  userId        Int
  currency      String
  amount        Int
  balanceAfter  Int
  reason        String
  referenceId   String?
  createdAt     DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, currency, createdAt])
  @@index([referenceId])
}
